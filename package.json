{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/check-props.mjs && vp build && npm run wayfinder:js",
        "build:ssr": "node scripts/check-props.mjs && vp build && vp build --ssr && npm run wayfinder:js",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "format": "vp fmt --write resources/js resources/css",
        "wayfinder:js": "node scripts/wayfinder-js.mjs",
        "test": "php artisan test --compact",
        "props:check": "node scripts/check-props.mjs",
        "test:js": "vitest run",
        "ci:check": "node scripts/check-props.mjs && npm run check && npm run test:js && composer test"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/echo-vue": "^2.6.3",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.3",
        "jsdom": "^31.0.1",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vitest": "^5.1.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
